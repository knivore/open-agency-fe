NEXTAUTH_SECRET=replace-me-in-local-dev
AUTH_TRUST_HOST=true

# Leave these unset for local LAN/Tailscale access. This lets Auth.js use the
# incoming Host header, so localhost, LAN IP, and Tailscale IP all work without
# editing this file when the laptop/network changes.
#
# Set these only when you need one fixed canonical auth origin, such as
# production-like OAuth callback testing or a public tunnel URL.
# NEXTAUTH_URL=http://localhost:3000
# AUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_AGENCY_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AGENCY_DEV_AUTH_ENABLED=true
NEXT_PUBLIC_ENABLE_MOCK_FALLBACKS=false
NEXT_PUBLIC_GRAPH_REALTIME_ENABLED=false

# LAN/mobile local development:
# 1. Start the frontend with `npm run dev:lan`.
# 2. Keep NEXTAUTH_URL and AUTH_URL unset so auth follows the host you open.
#    If you set them, use the single external URL that should own all auth callbacks,
#    for example a public tunnel URL or a deployed domain.
# 3. Prefer an explicit Open Agency runtime URL that the browser can reach.
# NEXT_PUBLIC_AGENCY_API_BASE_URL=http://<mac-lan-ip>:8000
#
# Local-only same-origin fallback for trusted LAN/phone testing:
# This re-enables the /backend/* rewrite. Do not use it for production or
# internet-facing deployments.
# AGENCY_FE_ENABLE_BACKEND_REWRITE=true
# NEXT_PUBLIC_AGENCY_API_BASE_URL=/backend
# AGENCY_INTERNAL_API_BASE_URL=http://127.0.0.1:8000

DEV_AUTH_EMAIL=dev@example.com
DEV_AUTH_PASSWORD=change-me
DEV_AUTH_NAME=Dev User
DEV_AUTH_USER_ID=dev-user
# Set false to skip backend auth probing and force the env-backed local fallback.
AGENCY_DEV_AUTH_BACKEND_ENABLED=true
# AGENCY_AUTH_LOGIN_PATH=/auth/login,/api/auth/login
# AGENCY_AUTH_ME_PATH=/auth/me,/api/auth/me,/me

# Compatibility fallback only. New setup should prefer NEXT_PUBLIC_AGENCY_API_BASE_URL.
LOCAL_BACKEND=http://127.0.0.1:8000

# Server-side BFF routes use this scoped shared key only to delegate the
# authenticated frontend session to Open Agency. Set the matching value in open-agency as
# AGENCY_INTERNAL_API_KEY. Compatibility fallbacks AGENCY_INTERNAL_API_KEY and
# BACKEND_INTERNAL_API_KEY are still accepted by the frontend.
# AGENCY_FE_BFF_IDENTITY_KEY=replace-with-shared-fe-bff-key

# Optional local TLS / proxy configuration
NODE_EXTRA_CA_CERTS=./certs/cloudflare.pem

# Optional provider settings used by legacy or future integrations
AZURE_OPENAI_API_KEY=
DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=

# Future / production auth paths. Not required for local dev auth mode.
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AD_PRIVATE_KEY=""
AD_CERT=""
X5T=""
REDIRECT_URL="http://localhost:3000/api/auth/callback/azure-ad"
